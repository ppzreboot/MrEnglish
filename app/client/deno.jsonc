{
  "tasks": {
    "dev": "deno run -A --unstable-bundle --watch=src,../../lib/client,../../lib/common ./build/dev.ts",
    "pro": "deno run -A --unstable-bundle ./build/pro.ts"
  },
  "imports": {
    "@ppz-ai/ecdict-common": "jsr:@ppz-ai/ecdict-common@^0.3.5",
    "@std/fs": "jsr:@std/fs@^1.0.20", // used in build
    "@types/react": "npm:@types/react@^19.2.7",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-hot-toast": "npm:react-hot-toast@^2.6.0",
    "wouter": "npm:wouter@^3.8.1",
    "zod": "npm:zod@^4.1.12"
  },
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "jsxImportSource": "react",
    "jsx": "react-jsx"
  }
}
