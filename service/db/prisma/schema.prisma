generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model mw_cache {
  key       String   @id
  content   Json
  valid     Boolean
  create_at DateTime @default(now())
}

model user {
  id         String      @id @default(uuid())
  create_at  DateTime    @default(now())
  email      String?     @unique
  identities identity[]
  sessions   session[]
}

model email_verification_code {
  email     String   // 收件邮箱
  purpose   String   // 'login' | 'bind_email'
  code      String
  create_at DateTime @default(now())

  @@id([email, purpose])
}

model identity {
  provider    String   // e.g., 'github', 'google'
  provider_id String   // e.g., '123456'
  user_id     String
  create_at   DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [id])

  @@id([provider, provider_id])
}

model session {
  token     String   @id
  user_id   String
  create_at DateTime @default(now())
  user      user     @relation(fields: [user_id], references: [id])
}
