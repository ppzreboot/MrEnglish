generator client {
  provider = "prisma-client"
  output   = "../service/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model mw_cache {
  key       String   @id
  content   Json
  valid     Boolean
  create_at DateTime @default(now())
}

model user {
  id         String      @id @default(uuid())
  create_at  DateTime    @default(now())
  identities identity[]
}

model identity {
  provider    String   // e.g., 'github', 'google'
  provider_id String   // e.g., '123456'
  user_id     String
  create_at   DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [id])

  @@id([provider, provider_id])
}
